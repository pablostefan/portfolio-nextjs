{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run: Next.js dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Run: Build project",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build"
    },
    {
      "name": "Run: Start production",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start",
      "preLaunchTask": "npm: build"
    }
  ]
}
